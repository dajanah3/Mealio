<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="Mealio logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.03"
                android:text="Mealio"
                android:textColor="#1C1C1E"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/settings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/settings_icon_dark"
            app:tint="#1C1C1E" />

    </RelativeLayout>

    <View
        android:id="@+id/top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/top_bar"
        android:background="#F2F2F7" />

    <LinearLayout
        android:id="@+id/home_page_main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/ad_layout"
        android:layout_below="@id/top_divider"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp">

        <TextView
            android:id="@+id/welcome_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="Welcome back"
            android:textColor="#1C1C1E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcome_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="What's on the menu today?"
            android:textColor="#8E8E93"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lookup"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="bottom|start"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp"
                android:text="Find a Recipe"
                android:textAlignment="textStart"
                android:textColor="#1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#F2F2F7"
                app:cornerRadius="22dp"
                app:elevation="0dp"
                app:icon="@drawable/find"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="44dp"
                app:iconTint="#1C1C1E"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="bottom|start"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp"
                android:text="Create a Recipe"
                android:textAlignment="textStart"
                android:textColor="#1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#F2F2F7"
                app:cornerRadius="22dp"
                app:elevation="0dp"
                app:icon="@drawable/create"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="44dp"
                app:iconTint="#1C1C1E"
                app:strokeWidth="0dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="bottom|start"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp"
                android:text="Favorited"
                android:textAlignment="textStart"
                android:textColor="#1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#F2F2F7"
                app:cornerRadius="22dp"
                app:elevation="0dp"
                app:icon="@drawable/bookmark_dark"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="44dp"
                app:iconTint="#1C1C1E"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mine"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="bottom|start"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp"
                android:text="My Recipes"
                android:textAlignment="textStart"
                android:textColor="#1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#F2F2F7"
                app:cornerRadius="22dp"
                app:elevation="0dp"
                app:icon="@drawable/created"
                app:iconGravity="top"
                app:iconPadding="0dp"
                app:iconSize="44dp"
                app:iconTint="#1C1C1E"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ad_layout"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal" />

</RelativeLayout>
